<UserControl x:Class="NetScope.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetScope.App.Controls">
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="性能记录" FontSize="26" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CollectorConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding CollectorStatus}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="  ·  "/>
                    <TextBlock Text="{Binding LastUpdateText}" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding CollectorHealthText}" ToolTip="{Binding CollectorHealthDetail}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="15,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,5" CornerRadius="12"
                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE72E;" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="数据仅存本机 · 只读分析" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ShowOverviewCommand}" Padding="18,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE9D9;" Margin="0,0,8,0"/>
                        <TextBlock Text="概览" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowEventsCommand}" Padding="18,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEventsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                        <TextBlock Text="事件时间线" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowProcessesCommand}" Padding="18,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessesSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE7C1;" Margin="0,0,8,0"/>
                        <TextBlock Text="进程中心" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowInsightsCommand}" Padding="18,8" Content="洞察">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsInsightsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Command="{Binding ShowConnectionsCommand}" Padding="18,8" Content="TCP 连接">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnectionsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Command="{Binding ShowReportsCommand}" Padding="18,8" Content="周/月报告">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsReportsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="8,0,4,0" ToolTip="立即刷新">
                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- 概览 -->
            <ScrollViewer Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ResponsivenessText}" ToolTip="{Binding ResponsivenessEvidence}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="CPU 占用" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,8"/>
                            <controls:SparklineVisual Values="{Binding CpuHistory}" EmptyText="连接后台记录后显示最近 15 分钟" Height="56"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="内存占用" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MemoryText}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                            <controls:SparklineVisual Values="{Binding MemoryHistory}" EmptyText="连接后台记录后显示最近 15 分钟" Height="40"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DiskText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="网络收发" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding NetworkText}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                            <controls:SparklineVisual Values="{Binding NetworkHistory}" EmptyText="连接后台记录后显示最近 15 分钟" Height="40"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <Button Command="{Binding MarkLagCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE7BA;" Margin="0,0,8,0"/>
                                    <TextBlock Text="刚才卡了"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="感到卡顿/风扇狂转时点一下，会记录当前现场并尝试归因（约 30–60 秒高频采样）。"
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding MarkStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="当前高影响进程（按证据分排序，非定责）" FontWeight="SemiBold" Margin="2,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TopProcesses}" SelectedItem="{Binding SelectedProcess}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource FlatListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,4" Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="CPU " Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding CpuText}" FontSize="11" Margin="0,0,10,0"/>
                                                    <TextBlock Text="内存 " Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding MemoryText}" FontSize="11" Margin="0,0,10,0"/>
                                                    <TextBlock Text="I/O " Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding IoText}" FontSize="11"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ImpactText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- V1.1 行内快捷强制结束：与进程中心同一评估与确认链 -->
                                                <Button Grid.Column="3" Command="{Binding DataContext.TerminateRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" ToolTip="强制结束该进程（先评估风险并确认）"
                                                        Visibility="{Binding ShowQuickTerminate, Converter={StaticResource BoolToVisibility}}"
                                                        Background="Transparent" BorderThickness="0" Padding="6,3" Margin="8,0,0,0" Cursor="Hand">
                                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE711;" FontSize="13" Foreground="{DynamicResource ErrorBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="最近事件（点开查看证据）" FontWeight="SemiBold" Margin="2,0,0,8"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding RecentEvents}" SelectedItem="{Binding SelectedEvent}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource FlatListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,4" Background="{DynamicResource SurfaceAltBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding TypeGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 过去 7 天影响排行：聚合历史事件的证据排序，不构成因果结论 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="过去 7 天最可能拖慢电脑的软件（按证据聚合排序，非定责）" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <TextBlock Text="{Binding ImpactRankingStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ImpactRanking}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" CornerRadius="6" Margin="0,0,0,3" Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RankText}" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding EventsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding LagText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScoreText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding HistoryNotice}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2,10,0,0"/>
            </Grid>
            </ScrollViewer>

            <!-- 事件时间线 -->
            <Grid Visibility="{Binding IsEventsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="10">
                    <ListBox ItemsSource="{Binding RecentEvents}" SelectedItem="{Binding SelectedEvent}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="8" Margin="0,0,0,6" Background="{DynamicResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding TypeGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TypeText}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"/>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <TextBlock Text="事件详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="选择左侧事件查看：时间范围、可信度、最可能原因、证据清单与处置建议。所有结论均为“可能/疑似”推断，不构成确定性定责。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentControl Content="{Binding SelectedEvent}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding TypeGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TypeText}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,2,0,0"/>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="White" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="最可能的原因（推断）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Cause}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="证据清单" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,0,0,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="·" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="处置建议" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,0,0,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="·" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="关联进程（按影响分排序，仅代表证据强度）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ContributorsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

                                            <!-- 事件前后指标对比（V1.0 端到端场景） -->
                                            <TextBlock Text="{Binding DataContext.EventContextStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="CPU（事件前后）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventCpuHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无系统采样" Height="52"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="内存占用 %" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventMemoryHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无系统采样" Height="52"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="网络 KB/s" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventNetworkHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无系统采样" Height="52"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 归因链：事件 → 候选进程 → 证据 → 根因假设 → 置信度 -->
                                            <StackPanel Visibility="{Binding DataContext.HasEventChain, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                                <TextBlock Text="归因链（全链路可回放）" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DataContext.EventChainHeadline, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,6"/>
                                                <ItemsControl ItemsSource="{Binding DataContext.EventChainSteps, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" FontSize="12"/>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding StringFormat=· {0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding DataContext.EventRecurrenceText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding DataContext.EventChainNote, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                                <Button Command="{Binding DataContext.ReplayEventEvidenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Content="回放原始证据" Padding="10,4" Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                                <TextBlock Text="{Binding DataContext.EventReplayStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>

                                                <StackPanel Visibility="{Binding DataContext.HasEventProcessTrend, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding DataContext.EventProcessTrendTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventProcessCpuHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无进程采样" Height="64"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventProcessMemoryHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无内存采样" Height="52" Margin="0,6,0,0"/>
                                                    <controls:SparklineVisual Values="{Binding DataContext.EventProcessIoHistory, RelativeSource={RelativeSource AncestorType=UserControl}}" EmptyText="无 I/O 采样" Height="52" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 进程中心 -->
            <Grid Visibility="{Binding IsProcessesSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                                <Button Grid.Column="1" Command="{Binding SearchProcessesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Content="搜索"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TopProcesses}" SelectedItem="{Binding SelectedProcess}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource FlatListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" CornerRadius="6" Margin="0,0,0,4" Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                    <TextBlock Text="{Binding ForegroundText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CpuText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PortsText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border Grid.Column="3" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ImpactText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- V1.1 行内快捷强制结束：点击时按需评估，不允许的目标会跳转到建议卡片说明 -->
                                                <Button Grid.Column="4" Command="{Binding DataContext.TerminateRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" ToolTip="强制结束该进程（先评估风险并确认）"
                                                        Visibility="{Binding ShowQuickTerminate, Converter={StaticResource BoolToVisibility}}"
                                                        Background="Transparent" BorderThickness="0" Padding="6,3" Margin="8,0,0,0" Cursor="Hand">
                                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE711;" FontSize="14" Foreground="{DynamicResource ErrorBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="进程详情" FontWeight="SemiBold" Margin="2,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="{Binding ProcessDetailStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,0,0,8"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="身份识别" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,0,0,4"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                                        Visibility="{Binding HasProcessIdentity, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProcessIdentityTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ProcessIdentityPublisher}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding ProcessIdentityProduct}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ProcessIdentitySignature}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ProcessIdentityPath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ProcessIdentityPurpose}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ProcessIdentityAdvice}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- V1.1 受控干预：结束进程建议卡片 -->
                                <TextBlock Text="结束进程建议（受控干预）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,10,0,4"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6"
                                        Visibility="{Binding HasTerminationAdvice, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TerminationLevelText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TerminationConclusion}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                                        <ItemsControl ItemsSource="{Binding TerminationEvidence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=· {0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding TerminationUnknowns}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=未知：{0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding TerminationAlternatives}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat=建议：{0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                            <Button Content="请求关闭" Command="{Binding RequestCloseProcessCommand}" Padding="12,4" Margin="0,0,8,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding AllowClose, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="强制结束" Command="{Binding TerminateProcessCommand}" Padding="12,4"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding AllowTerminate, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TerminationStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding ProcessHistoryTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,8,0,4" TextWrapping="Wrap"/>
                                <controls:SparklineVisual Values="{Binding ProcessCpuHistory}" EmptyText="选择进程后显示历史曲线" Height="72"/>
                                <TextBlock Text="私有内存趋势（MB）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,10,0,4"/>
                                <controls:SparklineVisual Values="{Binding ProcessMemoryHistory}" EmptyText="暂无内存历史" Height="58"/>
                                <TextBlock Text="磁盘 I/O 趋势（MB/s）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,10,0,4"/>
                                <controls:SparklineVisual Values="{Binding ProcessIoHistory}" EmptyText="暂无 I/O 历史" Height="58"/>
                                <TextBlock Text="{Binding ProcessWeekSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,14,0,4"/>
                                <ItemsControl ItemsSource="{Binding ProcessWeekEvents}" MaxHeight="150">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding TypeGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TypeText}" FontSize="12"/>
                                                <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="相关事件" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="2,14,0,4"/>
                                <ItemsControl ItemsSource="{Binding ProcessEvents}" MaxHeight="160">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock FontFamily="{StaticResource FluentIcons}" Text="{Binding TypeGlyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TypeText}" FontSize="12"/>
                                                <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding HistoryNotice}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="2,10,0,0"/>
            </Grid>
            <Grid Visibility="{Binding IsInsightsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Insights · 可回查洞察" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="从本机历史样本、性能事件、端口会话和连接记录生成；只排列证据，不下确定因果结论。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="分析" Command="{Binding LoadInsightsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding InsightKindOptions}" SelectedItem="{Binding InsightKindFilter}" Width="120" Margin="8,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding InsightDayOptions}" SelectedItem="{Binding InsightDays}" Width="80" Margin="8,0,0,0" ToolTip="分析天数"/>
                        <TextBox Text="{Binding InsightSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选进程名"/>
                    </DockPanel>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8"
                        Visibility="{Binding HasInsightSource, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding InsightSourceText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <ListBox Grid.Row="2" ItemsSource="{Binding Insights}" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="8,2" Margin="0,0,8,0"><TextBlock Text="{Binding KindText}" FontSize="11"/></Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding ProcessText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                    <Button Content="查看原始证据" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="10,4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.OpenInsightSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Text="{Binding InsightStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
            </Grid>
            <Grid Visibility="{Binding IsConnectionsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="TCP 连接与历史" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="首次/最后观察时间不等于精确握手/关闭时间；轮询可能漏掉短连接。关闭历史后只显示当前连接与已有记录。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="查询" Command="{Binding LoadConnectionsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ConnectionGroups}" SelectedItem="{Binding ConnectionGroup}" Width="120" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding ConnectionSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索进程名、PID、IP 或端口"/>
                    </DockPanel>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectionView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" RowDetailsVisibilityMode="VisibleWhenSelected" FontSize="11">
                    <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="进程 / PID" Binding="{Binding Process}" Width="160"/>
                        <DataGridTextColumn Header="远端 IP:端口" Binding="{Binding Remote}" Width="180"/>
                        <DataGridTextColumn Header="本地 IP:端口" Binding="{Binding Local}" Width="160"/>
                        <DataGridTextColumn Header="最后状态" Binding="{Binding State}" Width="150"/>
                        <DataGridTextColumn Header="首次观察" Binding="{Binding FirstSeen}" Width="105"/>
                        <DataGridTextColumn Header="最后观察" Binding="{Binding LastSeen}" Width="105"/>
                        <DataGridTextColumn Header="结束观察" Binding="{Binding End}" Width="105"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate><DataTemplate><TextBlock Text="{Binding Detail}" Margin="10" TextWrapping="Wrap"/></DataTemplate></DataGrid.RowDetailsTemplate>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
            </Grid>

            <!-- 周/月报告（V1.0）：本机汇总，可导出 Markdown -->
            <Grid Visibility="{Binding IsReportsSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="周报 / 月报" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="由本机历史证据汇总生成，与上一周期对比；报告只排列证据，不下确定因果结论，导出仅写本地文件。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="导出 Markdown" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"/>
                        <Button DockPanel.Dock="Right" Content="生成报告" Command="{Binding LoadReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriodFilter}" Width="90"/>
                        <TextBlock Text="{Binding ReportMetaText}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                            <TextBlock Text="{Binding ReportHeadline}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReportSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Delta}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                                               Visibility="{Binding HasDelta, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"
                                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Bullets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=· {0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding ReportStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
