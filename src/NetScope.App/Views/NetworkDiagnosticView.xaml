<UserControl x:Class="NetScope.App.Views.NetworkDiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetScope.App.Controls"
             xmlns:converters="clr-namespace:NetScope.App.Converters">
    <UserControl.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrush"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="快速网络诊断" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="检查本机、网卡、IP、网关、DNS 和公网目标，不执行下载测速"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="取消诊断" Command="{Binding CancelCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding RunDiagnosticCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="开始诊断"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EvidenceColumn" Width="300"/></Grid.ColumnDefinitions>

                <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,18,20,20">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="16,12" MinHeight="76">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding OverallStatus, Converter={StaticResource StatusBrush}}" BorderThickness="2">
                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE73E;" Foreground="{Binding OverallStatus, Converter={StaticResource StatusBrush}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="无下载与上传流量 · ICMP 失败不会单独判定断网" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center" Padding="10,5" CornerRadius="12" Background="#E7F0FD">
                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <controls:DiagnosticChainVisual Items="{Binding Stages}" DataContext="{Binding}" Height="100" Margin="2,10,2,0"/>
                        <ItemsControl ItemsSource="{Binding Stages}" Margin="0,-7,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,10,0,12" Height="194">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="网关延迟趋势" FontWeight="SemiBold"/>
                                    <TextBlock Text="10 次 ICMP · 按采样顺序" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                                <controls:SparklineVisual Grid.Row="1" Values="{Binding GatewayLatencySamples}" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding GatewayStatsText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="DNS / TCP / TLS 分项耗时" FontWeight="SemiBold"/>
                                    <TextBlock Text="真实请求耗时，不与网关延迟混算" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ProbeTimings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="2" Height="6" Value="{Binding BarValue, Mode=OneWay}" Maximum="1000" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ValueText}" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="尚无分项样本；运行快速诊断后显示。" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProbeTimings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Height="94">
                            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,6,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE823;" Foreground="{DynamicResource AccentBrush}" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="网关延迟" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding LatencyText}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="10 次采样均值" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/></StackPanel></Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="2,0,4,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE9F9;" Foreground="{DynamicResource SuccessBrush}" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="丢包 / 抖动" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock><Run Text="{Binding PacketLossText}" FontSize="17" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding JitterText}" FontSize="13"/></TextBlock><TextBlock Text="网关 ICMP 样本" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/></StackPanel></Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="4,0,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE701;" Foreground="{DynamicResource WarningBrush}" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="本地链路速率" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding LinkSpeedText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding LinkSpeedNote}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LinkSpeedNote}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/></StackPanel></Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="EvidencePanel" Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,20,18,20">
                        <TextBlock Text="证据与建议" FontSize="18" FontWeight="SemiBold"/>
                        <Border Margin="0,14,0,0" Padding="12" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedStage.Title}" FontWeight="SemiBold"/><Border Grid.Column="1" Padding="8,3" CornerRadius="10" Background="#FFF2D8"><TextBlock Text="{Binding SelectedStage.StatusDisplay}" Foreground="{Binding SelectedStage.Status, Converter={StaticResource StatusBrush}}" FontSize="10" FontWeight="SemiBold"/></Border></Grid><TextBlock Text="{Binding SelectedStage.Headline}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedStage.Metric}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="检测证据" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding SelectedStage.Evidence}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="{Binding DataContext.SelectedStage.Status, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StatusBrush}}" FontSize="9" Margin="0,3,0,0"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="建议" FontWeight="SemiBold" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding SelectedStage.Suggestions}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,8" Background="#EAF2FD" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE82F;" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="结论可信度" FontWeight="SemiBold" Margin="0,14,0,7"/><ProgressBar Height="6" Value="{Binding SelectedStage.Confidence}" Maximum="1" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="状态由颜色、图标和文字共同表达" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,10,0,0"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
