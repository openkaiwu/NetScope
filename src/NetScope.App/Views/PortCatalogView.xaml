<UserControl x:Class="NetScope.App.Views.PortCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2.35*" MinWidth="430"/><ColumnDefinition x:Name="CatalogGap" Width="12"/><ColumnDefinition x:Name="CatalogDetailsColumn" Width="1*" MinWidth="0"/></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid><TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="搜索 22、SSH、HTTP、远程登录或数据库" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CatalogSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding CatalogResultText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,3" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/></Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="全部" Command="{Binding SetCatalogProtocolFilterCommand}" CommandParameter="全部" Style="{StaticResource SecondaryButtonStyle}" Padding="11,8"/><Button Content="TCP" Command="{Binding SetCatalogProtocolFilterCommand}" CommandParameter="TCP" Style="{StaticResource SecondaryButtonStyle}" Padding="11,8" Margin="5,0,0,0"/><Button Content="UDP" Command="{Binding SetCatalogProtocolFilterCommand}" CommandParameter="UDP" Style="{StaticResource SecondaryButtonStyle}" Padding="11,8" Margin="5,0,0,0"/><Button Content="高风险" Command="{Binding SetCatalogProtocolFilterCommand}" CommandParameter="高风险" Style="{StaticResource SecondaryButtonStyle}" Padding="11,8" Margin="5,0,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding CatalogRowsView}" SelectedItem="{Binding SelectedCatalogRow}" AutoGenerateColumns="False" ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns><DataGridTextColumn Header="端口" Binding="{Binding PortRange}" Width="90"/><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="72"/><DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="125"/><DataGridTextColumn Header="中文用途" Binding="{Binding Description}" Width="*" MinWidth="190"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="当前状态" Binding="{Binding OccupancyText}" Width="145"/></DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Border x:Name="CatalogDetails" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" MinWidth="238">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                <TextBlock Text="端口百科" FontSize="17" FontWeight="SemiBold"/>
                <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"><StackPanel><TextBlock Text="{Binding SelectedCatalogRow.PortRange, StringFormat=端口 {0}, TargetNullValue=选择一条端口记录}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCatalogRow.Service, TargetNullValue=—}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedCatalogRow.Protocol}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel></Border>
                <TextBlock Text="标准 / 惯例用途" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock Text="{Binding SelectedCatalogRow.Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="常见软件" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="{Binding SelectedCatalogRow.CommonSoftware}" TextWrapping="Wrap"/>
                <TextBlock Text="当前状态" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="{Binding SelectedCatalogRow.OccupancyText}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="暴露风险" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="{Binding SelectedCatalogRow.RiskText}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedCatalogRow.ExposureAdvice}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <Border Background="#FFF2D8" CornerRadius="8" Padding="10" Margin="0,18,0,0"><TextBlock Text="标准用途不代表实际流量内容；请始终结合监听进程与地址判断。" TextWrapping="Wrap" Foreground="#9A6400"/></Border>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
