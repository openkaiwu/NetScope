<UserControl x:Class="NetScope.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NetScope.Core.Models;assembly=NetScope.Core">
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="后台行为、外观与诊断节点" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="后台与自启动" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="关闭主窗口后继续在托盘运行" IsChecked="{Binding CloseToTray}" Margin="0,16,0,0"/><CheckBox Content="当前用户登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"/><TextBlock Text="不需要管理员权限；托盘可打开、暂停、刷新和退出。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="主题" FontSize="17" FontWeight="SemiBold"/><ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Margin="0,14,0,0" Padding="8"><ComboBoxItem Content="跟随系统" Tag="{x:Static models:AppTheme.System}"/><ComboBoxItem Content="明亮" Tag="{x:Static models:AppTheme.Light}"/><ComboBoxItem Content="深色" Tag="{x:Static models:AppTheme.Dark}"/></ComboBox><TextBlock Text="Windows 11 使用 Mica；Windows 10 自动降级为实色 Fluent。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="刷新间隔" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="前台端口刷新（毫秒）" Margin="0,14,0,6"/><TextBox Text="{Binding ForegroundRefreshMilliseconds}"/><TextBlock Text="托盘后台刷新（毫秒）" Margin="0,12,0,6"/><TextBox Text="{Binding TrayRefreshMilliseconds}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="诊断目标" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="每行一个主机名；默认覆盖 Microsoft、Cloudflare 和百度。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,10"/><TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/><Border Background="#E7F7EF" CornerRadius="8" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock Text="隐私保护" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/><TextBlock Text="遥测永久关闭；日志不会记录完整 URL、SSID、MAC 或公网 IP。" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border>
            </StackPanel>
        </Grid></ScrollViewer>
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Text="{Binding SaveStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
    </Grid>
</UserControl>
