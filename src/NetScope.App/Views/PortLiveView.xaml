<UserControl x:Class="NetScope.App.Views.PortLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetScope.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="420"/><ColumnDefinition x:Name="DetailsGap" Width="12"/><ColumnDefinition x:Name="DetailsColumn" Width="1.1*" MinWidth="0"/></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="104"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource CardStyle}" Padding="13,9" Margin="0,0,6,0"><StackPanel><TextBlock Text="监听端口" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding ListeningCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Padding="13,9" Margin="2,0,4,0"><StackPanel><TextBlock Text="UDP 绑定" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding UdpCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Padding="13,9" Margin="4,0,2,0"><StackPanel><TextBlock Text="关联进程" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding ProcessCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Padding="13,9" Margin="6,0,0,0"><StackPanel><TextBlock Text="本次变化" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding ChangeCount}" FontSize="23" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,9" Margin="0,0,0,10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="端口光谱 · " FontWeight="SemiBold"/><TextBlock Text="{Binding SpectrumProtocolLabel}" FontWeight="SemiBold"/><TextBlock Text="  蓝色标准 · 浅绿候选 · 黄色动态 · 灰色排除 · 红色占用" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,2,0,0"/></StackPanel><controls:PortSpectrumVisual Grid.Row="1" Ports="{Binding SpectrumPorts}" SystemRanges="{Binding SystemPortRanges}" Protocol="{Binding SpectrumProtocolLabel}"/></Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="搜索端口、PID、进程或用途（支持 port: / pid: / proc:）" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SearchText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="全部" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8"/><Button Content="TCP" Command="{Binding SetFilterCommand}" CommandParameter="TCP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="6,0,0,0"/><Button Content="UDP" Command="{Binding SetFilterCommand}" CommandParameter="UDP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="6,0,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" ScrollViewer.CanContentScroll="True">
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Background" Value="#DDF5E8"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70"/><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="65"/><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="88"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="130"/><DataGridTextColumn Header="标准 / 惯例用途" Binding="{Binding Purpose}" Width="190"/><DataGridTextColumn Header="变化时间" Binding="{Binding ChangedText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" MinWidth="230">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                <TextBlock Text="端口详情" FontSize="17" FontWeight="SemiBold"/>
                <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"><StackPanel><TextBlock Text="{Binding SelectedRow.Port, StringFormat=端口 {0}, TargetNullValue=选择表格中的端口}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedRow.Service, TargetNullValue=—}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                <TextBlock Text="当前占用" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="{Binding SelectedRow.ProcessName, TargetNullValue=尚未选择}"/><TextBlock Text="{Binding SelectedRow.ProcessPath, TargetNullValue=从左侧选择一条绑定记录}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Text="标准 / 惯例用途" FontWeight="SemiBold" Margin="0,18,0,7"/><TextBlock Text="{Binding SelectedRow.Purpose, TargetNullValue=端口用途只描述注册或惯例用途，不推断真实流量内容}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Background="#EAF2FD" CornerRadius="8" Padding="10" Margin="0,18,0,0"><TextBlock Text="需要查询未占用端口？切换到“端口百科”。" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/></Border>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
