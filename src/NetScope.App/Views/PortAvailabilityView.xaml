<UserControl x:Class="NetScope.App.Views.PortAvailabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetScope.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="真实可用端口光谱" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="深绿仅表示刚刚通过独占绑定验证；浅绿只是理论候选" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="TCP" Command="{Binding SetRecommendationProtocolCommand}" CommandParameter="TCP" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7"/><Button Content="UDP" Command="{Binding SetRecommendationProtocolCommand}" CommandParameter="UDP" Style="{StaticResource SecondaryButtonStyle}" Padding="11,7" Margin="5,0,8,0"/><Button Content="验证前 20 个" Command="{Binding RefreshRecommendationsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="13,7"/></StackPanel></Grid>
                <controls:PortSpectrumVisual Grid.Row="1" Ports="{Binding AvailabilityOccupiedPorts}" RecommendedPorts="{Binding RecommendedPorts}" SystemRanges="{Binding SystemPortRanges}" Protocol="{Binding RecommendationProtocolLabel}" Margin="0,4,0,0"/>
                <Grid Grid.Row="2"><TextBlock Text="{Binding RangeSourceText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Button Content="重新读取系统范围" Command="{Binding ReloadSystemRangesCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="9,3" FontSize="10"/></Grid>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Content="全部" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="全部" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="当前推荐" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="当前推荐" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="当前占用" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="当前占用" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="候选范围" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="候选范围" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="标准服务" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="标准服务" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="动态端口" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="动态端口" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="系统排除" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="系统排除" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="高风险端口" Command="{Binding SetAvailabilityFilterCommand}" CommandParameter="高风险端口" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/></StackPanel></ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding AvailabilityRowsView}" AutoGenerateColumns="False" ScrollViewer.CanContentScroll="True">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter Property="Background" Value="#DDF5E8"/><Setter Property="Foreground" Value="#147A4D"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                <DataGrid.Columns><DataGridTextColumn Header="端口 / 范围" Binding="{Binding Range}" Width="120"/><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="75"/><DataGridTextColumn Header="分类" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="验证 / 来源" Binding="{Binding Status}" Width="190"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" MinWidth="260"/></DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
