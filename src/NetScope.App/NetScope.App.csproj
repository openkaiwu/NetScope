<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetScope.Core\NetScope.Core.csproj" />
    <ProjectReference Include="..\NetScope.Windows\NetScope.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NetScope.ico" />
    <Resource Include="Assets\NetScope.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetScope.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AssemblyName>NetScope</AssemblyName>
    <RootNamespace>NetScope.App</RootNamespace>
    <Version>0.2.0</Version>
    <Product>NetScope</Product>
    <Description>轻量 Windows 端口管理与网络诊断工具</Description>
    <Authors>NetScope contributors</Authors>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 构建后把后台 Collector 可执行文件复制到 App 输出目录，保证同目录可发现 -->
  <Target Name="StageCollector" AfterTargets="Build" Condition="'$(IsPublishing)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\NetScope.Collector\NetScope.Collector.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_CollectorOutput Include="$(MSBuildThisFileDirectory)..\NetScope.Collector\bin\$(Configuration)\net10.0-windows\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CollectorOutput)"
          DestinationFiles="$(OutDir)%(RecursiveDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
