<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetScope.Collector</AssemblyName>
    <RootNamespace>NetScope.Collector</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Version>0.2.0</Version>
    <Product>NetScope Collector</Product>
    <Description>NetScope 后台性能事件记录器</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetScope.Core\NetScope.Core.csproj" />
    <ProjectReference Include="..\NetScope.Windows\NetScope.Windows.csproj" />
  </ItemGroup>

</Project>
